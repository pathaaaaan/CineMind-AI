APP_NAME=CineMind AI
ENVIRONMENT=development
DATABASE_URL=postgresql://username:password@localhost:5432/cinemind
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
TMDB_API_KEY=replace-with-your-tmdb-api-key
FAISS_INDEX_PATH=../data/faiss/movies.index
FAISS_METADATA_PATH=../data/faiss/movie_metadata.json
